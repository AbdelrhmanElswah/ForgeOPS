{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "ForgeOps React (bundled by Next.js / Vite, never emitted by tsc)",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "allowJs": false
  }
}
