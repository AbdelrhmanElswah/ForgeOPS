{
  "name": "forgeops",
  "version": "0.0.0",
  "private": true,
  "description": "AI-powered software engineering automation platform",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run build --filter=@forgeops/backend^... && pnpm --filter @forgeops/backend dev:api",
    "dev:worker": "turbo run build --filter=@forgeops/backend^... && pnpm --filter @forgeops/backend dev:worker",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3"
  }
}
