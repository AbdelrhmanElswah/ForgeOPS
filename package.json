{
  "name": "forgeops",
  "version": "0.0.0",
  "private": true,
  "description": "AI-powered software engineering automation platform",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run build db:generate --filter=@forgeops/backend... && pnpm --filter @forgeops/backend dev:api",
    "dev:worker": "turbo run build db:generate --filter=@forgeops/backend... && pnpm --filter @forgeops/backend dev:worker",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "github:create-app": "node infra/github-app/create-app.mjs",
    "github:webhooks": "node infra/github-app/relay-webhooks.mjs",
    "db:migrate": "pnpm --filter @forgeops/backend db:migrate",
    "db:seed": "pnpm --filter @forgeops/backend db:seed",
    "db:studio": "pnpm --filter @forgeops/backend db:studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "smee-client": "^5.0.0",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3"
  }
}
