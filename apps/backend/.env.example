# Copy to .env for local development. Never commit .env.
NODE_ENV=development
LOG_LEVEL=debug

# API process
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Infrastructure (matches infra/docker/docker-compose.yml)
DATABASE_URL=postgresql://forgeops:forgeops@localhost:5433/forgeops
REDIS_URL=redis://localhost:6379/0

# Worker process
WORKER_CONCURRENCY=2

# Auth (generate a secret: node -e "console.log(crypto.randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=change-me-to-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# GitHub App: run `pnpm github:create-app` to fill these in (see infra/github-app/README.md)
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_PRIVATE_KEY_PATH=secrets/github-app.pem
# GITHUB_WEBHOOK_PROXY_URL=

# Agents (credentials: ANTHROPIC_API_KEY, or `ant auth login`)
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
# Optional per-role overrides:
# LLM_MODEL_PLANNER=
# LLM_MODEL_INVESTIGATOR=
# ANTHROPIC_API_KEY=
TASK_MAX_COST_USD=5
TASK_MAX_LLM_CALLS=40
TASK_MAX_TOOL_CALLS=150
