{
  "name": "@forgeops/backend",
  "version": "0.0.0",
  "private": true,
  "description": "ForgeOps backend: NestJS API and Worker processes",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api,worker -c gray,cyan,magenta \"pnpm:watch:tsc\" \"pnpm:watch:api\" \"pnpm:watch:worker\"",
    "dev:api": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api -c gray,cyan \"pnpm:watch:tsc\" \"pnpm:watch:api\"",
    "dev:worker": "tsc -p tsconfig.build.json && concurrently -k -n tsc,worker -c gray,magenta \"pnpm:watch:tsc\" \"pnpm:watch:worker\"",
    "watch:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "watch:api": "node --watch --enable-source-maps dist/entrypoints/api.main.js",
    "watch:worker": "node --watch --enable-source-maps dist/entrypoints/worker.main.js",
    "start:api": "node --enable-source-maps dist/entrypoints/api.main.js",
    "start:worker": "node --enable-source-maps dist/entrypoints/worker.main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@forgeops/agents": "workspace:*",
    "@forgeops/contracts": "workspace:*",
    "@langchain/core": "^1.2.18",
    "@langchain/langgraph": "^1.5.1",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "bullmq": "^6.3.17",
    "cookie-parser": "^1.4.7",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "octokit": "^5.0.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@forgeops/eslint-config": "workspace:*",
    "@forgeops/tsconfig": "workspace:*",
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.18",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "nock": "^15.0.3",
    "pino-pretty": "^13.2.0",
    "prisma": "~7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
